{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YUME Dev",
  "identifier": "com.deskmate.worklogqa",
  "bundle": { "active": false },
  "app": {
    "windows": [
      {
        "label": "pet", "url": "pet.html", "title": "YUME 开发版",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "width": 320, "height": 420, "transparent": true, "decorations": false,
        "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "shadow": false
      },
      {
        "label": "chat", "url": "chat.html", "title": "YUME 开发版聊天",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "dragDropEnabled": false, "width": 420, "height": 560,
        "x": -10000, "y": -10000, "transparent": true, "decorations": false,
        "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "shadow": false,
        "visible": false, "focus": false
      },
      {
        "label": "settings", "url": "settings.html", "title": "YUME 开发版设置",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "width": 720, "height": 520, "x": 100, "y": 100,
        "decorations": false, "transparent": true, "resizable": false, "shadow": false,
        "skipTaskbar": false, "visible": true, "focus": true
      }
    ]
  }
}
