{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YUME Unified History QA",
  "identifier": "com.deskmate.unifiedhistoryqa.run20260924a",
  "build": {
    "beforeDevCommand": "bun run prepare:sidecar && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run prepare:workbench && bun run prepare:sidecar && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "url": "pet.html",
        "title": "YUME Unified History QA pet",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=55893",
        "width": 320,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "chat",
        "url": "chat.html",
        "title": "YUME Unified History QA chat",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=55893",
        "dragDropEnabled": false,
        "width": 420,
        "height": 560,
        "x": 540,
        "y": 100,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true,
        "focus": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "YUME Unified History QA settings",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=55893",
        "width": 720,
        "height": 520,
        "x": 50,
        "y": 100,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/packs/**/*"
        ]
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' customprotocol: asset: ipc: http://ipc.localhost http://asset.localhost http://127.0.0.1:* ws://127.0.0.1:* blob: data:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installerHooks": "nsis/yume-installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0MzAxREYxQkQzRDc4NkQKUldSdGVEMjk4UjB3Rk9MWTdaZ2oyc3BXSUN0UmhsRkV4azR6OTBGVWQzanhWL0ZQbXNvMjhXcVUK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "version": "0.4.8",
  "mainBinaryName": "yume-unified-history-qa"
}
