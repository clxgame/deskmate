!macro NSIS_HOOK_PREINSTALL
  ; Release only this install's app and marked OpenCode sidecar before copying.
  System::Call 'Kernel32::SetEnvironmentVariable(t, t) i("DESKMATE_INSTALL_DIR", "$INSTDIR").r0'
  nsExec::ExecToLog '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -EncodedCommand '
  Pop $0
  nsExec::ExecToLog '"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -EncodedCommand '
  Pop $0
  System::Call 'Kernel32::SetEnvironmentVariable(t, t) i("DESKMATE_INSTALL_DIR", "").r0'
!macroend
