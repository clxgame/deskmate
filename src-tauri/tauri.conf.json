{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deskmate",
  "version": "0.1.5",
  "identifier": "com.deskmate.desktop",
  "build": {
    "beforeDevCommand": "bun run prepare:sidecar && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run prepare:sidecar && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "url": "pet.html",
        "title": "deskmate",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "width": 320,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "chat",
        "url": "chat.html",
        "title": "deskmate chat",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "dragDropEnabled": false,
        "width": 420,
        "height": 560,
        "x": -10000,
        "y": -10000,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "deskmate 设置",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "width": 720,
        "height": 520,
        "x": -10000,
        "y": -10000,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/packs/**/*"]
      },
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' customprotocol: asset: ipc: http://ipc.localhost http://asset.localhost http://127.0.0.1:* blob: data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0MzAxREYxQkQzRDc4NkQKUldSdGVEMjk4UjB3Rk9MWTdaZ2oyc3BXSUN0UmhsRkV4azR6OTBGVWQzanhWL0ZQbXNvMjhXcVUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
